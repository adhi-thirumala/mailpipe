{
  "name": "mailpipe",
  "compatibility_date": "2026-02-07",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/index.ts",
  "kv_namespaces": [{ "binding": "EMAIL_KV", "id": "f0acefa95dfc4640ac499f9df4572ceb" }],
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true,
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1,
    },
  },
}
